# =============================================================================
# Project O.R.B.I.T. — environment template
# Copy to .env and fill in real values. NEVER commit .env itself.
# =============================================================================

# --- Google Cloud -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id

GOOGLE_GENAI_USE_VERTEXAI=TRUE

GOOGLE_CLOUD_LOCATION=global


GOOGLE_APPLICATION_CREDENTIALS=
# --- API security ---------------------------------------------------------------
# Generate a strong key with:  openssl rand -hex 32
ORBIT_API_KEY=

# --- Model overrides (optional; defaults shown) -----------------------------------
ORBIT_COMMANDER_MODEL_ID=gemini-3.7-flash
ORBIT_ASTRO_MODEL_ID=gemini-3.5-flash
ORBIT_DIPLOMAT_MODEL_ID=gemini-3.5-flash
ORBIT_VERTEX_MODEL_ID=gemini-3.5-flash

# Generative media
ORBIT_MEDIA_LOCATION=us-central1
ORBIT_EDGE_MODEL_ID=gemma-4-26b-a4b-it-maas
ORBIT_VEO_MODEL_ID=veo-3.0-generate-001
ORBIT_LYRIA_MODEL_ID=lyria-002

# --- Phase 7 switches --------------------------------------------------------------
ORBIT_ENABLE_EDGE_AUTONOMY=true
# ORBIT_ENABLE_REAL_VEO=1
# ORBIT_ENABLE_REAL_LYRIA=1

# --- Persistence ------------------------------------------------------------------
# auto = Firestore when credentials/emulator/project are present, else in-memory.
ORBIT_MEMORY_BACKEND=auto
# For local Firestore emulation:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Phase 8: long-running watches ---------------------------------------------------
ORBIT_WATCH_DEFAULT_INTERVAL_HOURS=6
ORBIT_WATCH_ESCALATE_BAND=HIGH
ORBIT_WATCH_SUPERVISOR_POLL_SECONDS=60

# --- Phase 8: real Space-Track.org data -----------------------------------------------
# Free account: https://www.space-track.org
# Verify with:  python scripts/spacetrack_probe.py
# SPACETRACK_USERNAME=
# SPACETRACK_PASSWORD=
SPACETRACK_CACHE_TTL_SECONDS=21600
SPACETRACK_MIN_INTERVAL_SECONDS=3

SPACETRACK_MAX_PER_MINUTE=20
SPACETRACK_MAX_PER_HOUR=250

# --- Phase 8: vector memory -------------------------------------------------------------
ORBIT_EMBED_MODEL_ID=text-embedding-005

# --- Phase 10: self-evolution ------------------------------------------------------------
ORBIT_LEARNING_MODEL_ID=gemini-3.5-flash
ORBIT_META_CRITIC_MODEL_ID=gemini-3.7-flash
ORBIT_EVOLUTION_MIN_OUTCOMES=5
ORBIT_EVOLUTION_MAX_REJECTIONS=3
ORBIT_EVOLUTION_MAX_ENVELOPE_PUSHES=3
ORBIT_EVOLUTION_MIN_CONFIDENCE=0.3

# --- Phase 11: conjunction debate ---------------------------------------------------------
# ORBIT_ENABLE_DEBATE=true
ORBIT_STRATEGIST_MODEL_ID=gemini-3.5-flash
ORBIT_DEBATE_JUDGE_MODEL_ID=gemini-3.7-flash
ORBIT_DEBATE_MAX_ROUNDS=2
ORBIT_DEBATE_TIME_BUDGET_S=45

# ORBIT_ADMIRAL_FUEL_RESERVE_PERCENT=5.0
# ORBIT_ADMIRAL_FUEL_MARGIN_PERCENT=15.0

#Manoeuvre command authentication
# ORBIT_COMMAND_SIGNING_KEY=

#Gemini 3.x thinking budget
# ORBIT_THINKING_LEVEL=LOW

# --- Cloud Run injects PORT automatically (default 8080 locally) --------------------
PORT=8080
